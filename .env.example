# Copy to .env and adjust as needed. All values shown are the defaults.

# --- Forecasting ---
# Overlays documented, seeded demand drivers on the near-constant 30-day
# source data so forecasting is a genuine task. See data/variability.py.
SYNTHETIC_VARIABILITY=True

# --- LLM provider for Pydantic-AI agents (none | ollama | anthropic | openai) ---
# Agents only write rationale/narrative text over ML+rule outputs - they
# never produce forecast numbers, and every agent has a rule-based fallback
# if the LLM is unreachable or LLM_PROVIDER=none.
#
# Local dev default is "ollama" (assumes a local Ollama server). Public cloud
# deployments should set LLM_PROVIDER=none - no API key required, no network
# calls made, rule-based rationale only. See DEPLOYMENT.md.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Deployment / server ---
# Port uvicorn binds to. Cloud platforms (Render/Railway) inject their own
# PORT value at runtime - leave this as-is locally.
PORT=8000

# Comma-separated list of allowed frontend origins for CORS, e.g.
# "https://my-app.vercel.app,https://my-app-git-main.vercel.app". Defaults to
# "*" (allow all) for local dev and initial deployment smoke-testing - lock
# this down once your frontend's deployed URL is known.
ALLOWED_ORIGINS=*
